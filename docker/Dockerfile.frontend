FROM node:20-alpine AS builder
WORKDIR /workspace
RUN npm install -g pnpm

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* tsconfig.json ./
COPY packages/ ./packages/
COPY apps/admin/package.json ./apps/admin/
COPY apps/tenant/package.json ./apps/tenant/
COPY apps/maintenance/package.json ./apps/maintenance/

# Run install (ignore lock if not available during initial generation)
RUN pnpm install --no-frozen-lockfile

# Copy application source files
COPY apps/admin/ ./apps/admin/
COPY apps/tenant/ ./apps/tenant/
COPY apps/maintenance/ ./apps/maintenance/

# Build frontends
RUN pnpm run build

# Nginx serving stage
FROM nginx:alpine
COPY --from=builder /workspace/apps/admin/dist /usr/share/nginx/html/admin
COPY --from=builder /workspace/apps/tenant/dist /usr/share/nginx/html/tenant
COPY --from=builder /workspace/apps/maintenance/dist /usr/share/nginx/html/maintenance
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
