# Pinned python:3.11-slim (Bookworm) for stability (AUD-039)
FROM python:3.11.9-slim-bookworm

# Add a non-root user (AUD-038)
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY apps/backend/requirements.txt ./

# Install python packages
RUN pip install --no-cache-dir -r requirements.txt

# Create directories and change ownership before switching user
RUN mkdir -p /workspace && chown -R appuser:appgroup /workspace

# Switch to non-root user
USER appuser

# Copy application files (with ownership)
COPY --chown=appuser:appgroup apps/backend/ ./

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
