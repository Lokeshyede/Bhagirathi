# Production Environment Variables Template
# Set these variables in Railway (Backend) and Vercel (Frontends)

# ── Backend (Railway) ────────────────────────────────────────────────────────
APP_ENV=production
DATABASE_URL=postgresql://...
SECRET_KEY=generate_a_secure_64_character_random_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["https://bhagirathi-admin-seven.vercel.app","https://bhagirathi-tenant-ten.vercel.app"]

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push / VAPID (Generate via: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@bhagirathihostel.com

# ── Frontends (Vercel Project Settings) ──────────────────────────────────────
VITE_API_URL=https://bhagirathibackend-production.up.railway.app
