FROM node:20-alpine AS builder
WORKDIR /workspace
RUN npm install -g pnpm

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* tsconfig.json ./
COPY packages/ ./packages/
COPY apps/tenant/package.json ./apps/tenant/

# Run install
RUN pnpm install --no-frozen-lockfile

# Copy application source files
COPY apps/tenant/ ./apps/tenant/

# Build tenant app
RUN pnpm --filter tenant-app build

# Nginx serving stage
FROM nginx:alpine
COPY --from=builder /workspace/apps/tenant/dist /usr/share/nginx/html
COPY docker/nginx/nginx.tenant.conf /etc/nginx/nginx.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
